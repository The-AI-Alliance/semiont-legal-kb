{
  "name": "Semiont Template KB",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/common-utils:2": {},
    // Required for `gh codespace ssh` / `gh codespace cp`: the base image
    // ships no SSH server (unlike GitHub's default Codespaces image), and
    // without one every CLI route into the codespace fails — including
    // `semiont useradd --repo …`, which runs the codespace's own launcher
    // over ssh to create the first admin.
    "ghcr.io/devcontainers/features/sshd:1": {}
  },

  // The machine the launcher's memory table is sized for, and the one
  // `semiont start --runtime codespace` requests (premiumLinux).
  "hostRequirements": {
    "cpus": 8,
    "memory": "32gb"
  },

  "containerEnv": {
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}"
  },

  "postStartCommand": ".devcontainer/post-start.sh",

  "forwardPorts": [3000, 4000, 8080, 16686, 9090, 7474],
  "portsAttributes": {
    "3000": { "label": "Semiont Browser", "onAutoForward": "notify" },
    "4000": { "label": "Gateway API", "onAutoForward": "notify" },
    "8080": { "label": "Keycloak", "onAutoForward": "silent" },
    "16686": { "label": "Jaeger UI", "onAutoForward": "notify" },
    "9090": { "label": "Prometheus", "onAutoForward": "notify" },
    "7474": { "label": "Neo4j Browser", "onAutoForward": "silent" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
